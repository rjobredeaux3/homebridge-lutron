{
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "declarationDir": "temp",
        "outDir": "lib",
        "module": "CommonJS",
        "target": "ES2018",
        "noImplicitAny": true,
        "noImplicitThis": true,
        "noImplicitReturns": true,
        "strictFunctionTypes": true,
        "strictNullChecks": true,
        "strictPropertyInitialization": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "allowJs": true,
        "paths": {
            "@mkellsy/leap-client": ["../leap-client"]
        }
    },
    "include": ["**/*.ts"],
    "exclude": ["coverage", "test", "lib", "node_modules"]
}
